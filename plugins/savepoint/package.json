{
  "name": "@yhb/dsh-plugin-savepoint",
  "version": "0.5.0",
  "description": "[fork] DSH 配置快照/撤销：改动前留快照，坏了从 WebUI 或离线 CLI 回滚（上游 dsh-undo-savepoint@0.5.0，MIT）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/check-size.mjs && node tools/check-version.mjs && node tools/check-routes.mjs && node tools/smoke-test.mjs && node tools/undo-server-smoke.mjs && node tools/home-resolution-test.mjs && node tools/e2e-watch.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "dsh": ">=0.0.1-0 || >=0.1.0-rc.2 || >=0.1.1-rc.1 || >=0.1.2-alpha.2 || >=0.1.2-rc.1 || >=0.1.5-rc.1 || >=0.1.5-rc.2 || >=0.2.0-rc.2",
    "node": ">=20.0.0"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lire1131/dsh-undo-savepoint.git"
  },
  "homepage": "https://github.com/lire1131/dsh-undo-savepoint",
  "bugs": {
    "url": "https://github.com/lire1131/dsh-undo-savepoint/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "undo",
    "redo",
    "rollback",
    "snapshot",
    "backup",
    "crash-recovery",
    "safe-mode",
    "windows",
    "powershell"
  ],
  "private": true
}
